# Copia este archivo como ".env" y completa los valores reales.
# El archivo ".env" NUNCA debe subirse a GitHub (ver .gitignore).

SECRET_KEY=cambia-esta-clave-por-una-generada-para-produccion
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Motor de base de datos:
# - Desarrollo local (sin BD instalada): django.db.backends.sqlite3
# - EC2 con MySQL/phpMyAdmin:            django.db.backends.mysql
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
