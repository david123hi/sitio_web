# Copia este archivo como ".env" y completa los valores reales.
# El archivo ".env" NUNCA debe subirse a GitHub (ver .gitignore).

SECRET_KEY=cambia-esta-clave-por-una-generada-para-produccion
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Motor de base de datos:
# - Desarrollo local (sin BD instalada): django.db.backends.sqlite3
# - EC2 con MySQL/phpMyAdmin:            django.db.backends.mysql
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# --- Correo (recuperación de contraseña) ---
# Desarrollo: los correos se imprimen en la consola donde corre runserver.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Para enviar correos reales (EC2 / demostración) usa SMTP, por ejemplo Gmail
# con una "contraseña de aplicación" (NO tu contraseña normal):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=tu_correo@gmail.com
# EMAIL_HOST_PASSWORD=contraseña-de-aplicacion
# DEFAULT_FROM_EMAIL=tu_correo@gmail.com
